# Harness Agentic Framework - Environment Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sandboxing
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Agent Configuration
AGENT_MAX_CONCURRENT_TASKS=10
AGENT_TIMEOUT=300

# Checkpointing
CHECKPOINT_DIR=./checkpoints
CHECKPOINT_INTERVAL=60

# Monitoring
METRICS_ENABLED=true
TRACING_ENABLED=true

# Development Tools
GIT_ENABLED=true
SHELL_ENABLED=true
PYTHON_EXECUTION_ENABLED=true

# API Keys (for future external integrations)
# GITHUB_TOKEN=
# OPENAI_API_KEY=
