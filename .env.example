# Harness Agentic Framework - Environment Variables
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider API Keys
# =============================================================================
# Uncomment and set the API key for your preferred LLM provider

# Mistral AI (https://mistral.ai/)
# MISTRAL_API_KEY=your_mistral_api_key_here

# OpenAI (https://openai.com/)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (https://anthropic.com/)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (https://cloud.google.com/vertex-ai)
# GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Default LLM Configuration
# =============================================================================

# Default provider to use (if multiple are configured)
# Options: mistral-large, gpt-4, gpt-3.5-turbo, claude-3-sonnet-20240229, etc.
# For Ollama: use "ollama/smollm:135m", "ollama/mistral", etc.
# First pull the model with: ollama pull smollm:135m
DEFAULT_LLM_PROVIDER=ollama/smollm:135m

# Default temperature for LLM responses (0.0 - 2.0)
DEFAULT_LLM_TEMPERATURE=0.7

# Default maximum tokens for LLM responses
# DEFAULT_LLM_MAX_TOKENS=4096

# Request timeout in seconds
DEFAULT_LLM_TIMEOUT=120.0

# =============================================================================
# Custom Provider URLs (for self-hosted or custom endpoints)
# =============================================================================

# Mistral-compatible endpoint (e.g., self-hosted Mistral)
# MISTRAL_API_BASE_URL=https://your-mistral-endpoint/v1

# OpenAI-compatible endpoint (e.g., local vLLM)
# OPENAI_API_BASE_URL=http://localhost:8000/v1

# Ollama (local LLM runtime - https://ollama.com/)
# Base URL for Ollama API (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434

# Default model for Ollama
# Available models: smollm:135m, llama3, llama2, mistral, phi3, qwen2.5, etc.
OLLAMA_MODEL=smollm:135m

# =============================================================================
# Usage Examples
# =============================================================================
#
# After setting your API keys, you can run:
#
# 1. Configure and test providers:
#    python scripts/setup_llm.py
#
# 2. Run TUI with LLM:
#    python scripts/run_tui_with_llm.py
#
# 3. Or with Make:
#    make install-llm
#    make setup-llm
#    make run-tui

# =============================================================================
# Supported Providers via LiteLLM
# =============================================================================
#
# OpenAI: gpt-4, gpt-4-32k, gpt-4-0613, gpt-3.5-turbo, gpt-3.5-turbo-16k
# Mistral: mistral-tiny, mistral-small, mistral-medium, mistral-large, mixtral-8x7b
# Anthropic: claude-3-sonnet, claude-3-haiku, claude-3-opus, claude-2
# Google: gemini-pro, gemini-ultra
# Local: (via Ollama) llama2, mistral, phi-2, qwen2.5:3b, etc.
#       (via vLLM) hosted_vllm/llama2, etc.
