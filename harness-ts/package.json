{
  "name": "harness-ts",
  "version": "1.0.0",
  "description": "Harness Agentic Framework - TypeScript Edition (powering pi-mono)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "start:tui": "node dist/tui/app.js",
    "start:dev": "ts-node src/index.ts",
    "start:tui:dev": "ts-node src/tui/app.ts",
    "dev": "ts-node src/index.ts",
    "dev:tui": "ts-node src/tui/app.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "multi-agent",
    "orchestration",
    "tui",
    "pi-mono"
  ],
  "author": "thomas",
  "license": "MIT",
  "dependencies": {
    "@mariozechner/pi-ai": "^0.72.1",
    "@mariozechner/pi-agent-core": "^0.72.1",
    "@mariozechner/pi-tui": "^0.72.1",
    "dotenv": "^16.4.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
