# Harness-TS Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Default LLM provider and model
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama-3.1-8b

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama-3.1-8b

# Mistral
MISTRAL_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google (Gemini)
GEMINI_API_KEY=

# =============================================================================
# Agent Configuration
# =============================================================================

# Routing strategy: keyword, capability, hybrid, round_robin, priority, learned
ROUTING_STRATEGY=hybrid

# Decomposition strategy: template, semantic, hybrid, recursive
DECOMPOSITION_STRATEGY=hybrid

# =============================================================================
# Application Configuration
# =============================================================================

# Port for the TUI server (if applicable)
PORT=3000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Environment: development, production
NODE_ENV=development
